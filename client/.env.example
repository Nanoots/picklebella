# ---------------------------------------------------------------------------
# Client environment. Copy to `.env.local` and fill in.
#
# EVERY value here is compiled into the JavaScript bundle and is PUBLIC.
# Only ever put publishable/anon values in this file. Never a service-role key,
# never a database password, never an API secret.
# ---------------------------------------------------------------------------

# Base URL of the deployed server project (no trailing slash).
# Local dev:  http://localhost:3000
VITE_API_URL=http://localhost:3000

# Supabase project URL — safe to expose.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable ("anon") key — safe to expose ONLY because row level
# security is enabled on every table. See server/supabase/migrations.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
