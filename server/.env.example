# ===========================================================================
#  THIS IS A TEMPLATE. IT IS COMMITTED TO GIT AND IS PUBLIC.
#
#  NEVER PUT A REAL SECRET IN THIS FILE.
#
#  Copy it to `.env` (which is git-ignored) and put real values THERE:
#      cp .env.example .env
#
#  A service-role key was once pasted into this file and pushed to a public
#  repository. If that happens again, the key must be rotated in Supabase —
#  deleting the line is not enough, because git keeps history.
# ===========================================================================

# Supabase project URL. Public information — safe to keep here.
SUPABASE_URL=https://nudbgiikbquoqeccjaxh.supabase.co

# SERVICE ROLE / secret key. Bypasses row level security completely — it is
# the keys to the whole database. Server-side only, never VITE_-prefixed,
# never sent to a browser, never committed.
#
#   Leave blank here. Put the real value in .env and in Vercel only.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable ("anon") key. Safe to expose — it ships in the browser bundle
# already — but keep this file consistent and set it in .env too.
SUPABASE_ANON_KEY=

# Comma-separated list of origins allowed to call this API. No wildcards, no
# trailing slashes. Anything not listed gets no CORS headers back.
# Must be non-empty in production or the server refuses to start.
# e.g. https://picklebella-client.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Secret used to sign price quotes so the browser cannot invent its own totals.
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUOTE_SIGNING_SECRET=

# How long a price quote stays valid, in seconds. Long enough to fill in a
# booking form, short enough that stale prices can't be hoarded.
QUOTE_TTL_SECONDS=900

# ---------------------------------------------------------------------------
#  PayMongo — the payment gateway
#
#  Without these, /api/bookings answers 503 and no booking can be completed.
#  Everything else (browsing courts, availability, the admin screens) keeps
#  working, which is why they are optional rather than required at boot.
# ---------------------------------------------------------------------------

# Secret key from the PayMongo dashboard: Developers -> API Keys.
#   sk_test_...  sandbox; no real money moves
#   sk_live_...  real charges
#
# This is NOT your wallet/merchant account number — an account number cannot
# authenticate an API call. Server-side only; it can move money. Leave blank
# here and set the real value in .env and in Vercel.
PAYMONGO_SECRET_KEY=

# Webhook signing secret (whsk_...), issued when you register the webhook:
#   POST https://api.paymongo.com/v1/webhooks
#   url:    https://<your-server>.vercel.app/api/payments/webhook
#   events: payment.paid, payment.failed
#
# Without it the webhook is refused, and a payment is only confirmed when the
# customer lands back on the site.
PAYMONGO_WEBHOOK_SECRET=

# Where the wallet returns the customer. Must be the CLIENT origin, no
# trailing slash. Defaults to the first entry in ALLOWED_ORIGINS.
PUBLIC_APP_URL=http://localhost:5173

# How long a court is held while the customer is away paying, in seconds.
# Long enough to finish a GCash flow, short enough that an abandoned checkout
# frees the slot quickly.
PAYMENT_HOLD_SECONDS=900
