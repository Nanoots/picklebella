# ---------------------------------------------------------------------------
# Server environment. Copy to `.env` for local dev; in production set these as
# Vercel Environment Variables (Project -> Settings -> Environment Variables).
#
# NOTHING in this file is safe to expose. It is git-ignored on purpose. If any
# of these values ever ends up in the client bundle, in a log line, or in a
# commit, treat it as compromised and rotate it immediately.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# SERVICE ROLE key. This bypasses row level security completely — it is the
# keys to the whole database. Server-side only, never VITE_-prefixed, never
# sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable ("anon") key. Used only to verify user access tokens.
SUPABASE_ANON_KEY=

# Comma-separated list of origins allowed to call this API. No wildcards, no
# trailing slashes. Anything not listed gets no CORS headers back.
# e.g. https://picklebella-park.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Secret used to sign price quotes so the browser cannot invent its own totals.
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUOTE_SIGNING_SECRET=

# How long a price quote stays valid, in seconds. Long enough to fill in a
# booking form, short enough that stale prices can't be hoarded.
QUOTE_TTL_SECONDS=900
